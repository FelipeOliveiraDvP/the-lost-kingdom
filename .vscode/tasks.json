{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Python: Format",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/poe",
      "args": ["format"],
      "problemMatcher": []
    },
    {
      "label": "Python: Lint",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/poe",
      "args": ["lint"],
      "problemMatcher": []
    },
    {
      "label": "Python: Tests",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/poe",
      "args": ["test"],
      "problemMatcher": []
    },
    {
      "label": "Python: Full Check",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/poe",
      "args": ["check"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}